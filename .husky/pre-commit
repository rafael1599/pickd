# Warn if too many files staged (likely accidental mass-format)
STAGED_COUNT=$(git diff --cached --name-only | wc -l | tr -d ' ')
if [ "$STAGED_COUNT" -gt 15 ]; then
  echo ""
  echo "⚠️  WARNING: $STAGED_COUNT files staged. If this is an accidental mass-format, unstage and commit only the files you changed."
  echo "   To proceed anyway: git commit --no-verify"
  echo ""
fi

npx lint-staged

# Typecheck when TS/TSX files are staged. `vite build` does not typecheck, so
# without this gate type errors pile up unnoticed — 31 accumulated before the
# first sweep, then 15 more landed the next day. Incremental, so only the first
# run pays full price.
if git diff --cached --name-only --diff-filter=ACM | grep -qE '\.(ts|tsx)$'; then
  echo "🔍 Typechecking…"
  if ! npx tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc-precommit.tsbuildinfo; then
    echo ""
    echo "❌ Type errors above. Fix them, or bypass with: git commit --no-verify"
    exit 1
  fi
fi
